{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Sorted bar chart for national grouped Type share.",
  "width": "container",
  "height": 285,
  "data": {
    "url": "data/housing_type_compact_2025.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "Type",
          "type": "nominal",
          "sort": "-x",
          "title": null
        },
        "x": {
          "field": "Transactions",
          "type": "quantitative",
          "title": "Transactions"
        },
        "color": {
          "field": "Median_Price",
          "type": "quantitative",
          "title": "Median Property Price (RM)",
          "scale": {
            "scheme": "blues"
          }
        },
        "tooltip": [
          {
            "field": "Type",
            "title": "Grouped Type"
          },
          {
            "field": "Transactions",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "Median_Price",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "Median_PSF",
            "type": "quantitative",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 11
      },
      "encoding": {
        "y": {
          "field": "Type",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "Transactions",
          "type": "quantitative"
        },
        "text": {
          "field": "Transactions",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "title": {
    "text": "Which property group dominates national transactions?",
    "subtitle": "A sorted bar chart replaces the donut so smaller categories remain comparable by length"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#e7ecf2"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom"
    },
    "title": {
      "font": "Inter",
      "fontSize": 16,
      "anchor": "start",
      "fontWeight": "bold",
      "subtitleFont": "Inter",
      "subtitleFontSize": 12,
      "subtitleColor": "#64748b"
    }
  }
}
