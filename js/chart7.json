{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Compact State by grouped Type heatmap using Transactions.",
  "width": "container",
  "height": 335,
  "data": {
    "url": "data/housing_state_type_tenure_compact_2025.csv"
  },
  "params": [
    {
      "name": "TenureChoice",
      "value": "Freehold",
      "bind": {
        "input": "select",
        "options": [
          "Freehold",
          "Leasehold"
        ],
        "name": "Tenure: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.Tenure == TenureChoice"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 0.7
  },
  "encoding": {
    "x": {
      "field": "Type",
      "type": "nominal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelLimit": 115
      },
      "sort": [
        "Terrace-based homes",
        "High-rise homes",
        "Semi-D / Cluster homes",
        "Bungalow-based homes",
        "Town House",
        "Other property types"
      ]
    },
    "y": {
      "field": "State",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "color": {
      "aggregate": "sum",
      "field": "Transactions",
      "type": "quantitative",
      "title": "Transactions",
      "scale": {
        "scheme": "oranges"
      }
    },
    "tooltip": [
      {
        "field": "State"
      },
      {
        "field": "Type",
        "title": "Grouped Type"
      },
      {
        "field": "Tenure"
      },
      {
        "aggregate": "sum",
        "field": "Transactions",
        "type": "quantitative",
        "format": ",.0f"
      },
      {
        "aggregate": "mean",
        "field": "Median_Price",
        "type": "quantitative",
        "format": ",.0f"
      }
    ]
  },
  "title": {
    "text": "Where are the active state\u2013type combinations?",
    "subtitle": "Tenure filter keeps the ownership comparison"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#e7ecf2"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom"
    },
    "title": {
      "font": "Inter",
      "fontSize": 16,
      "anchor": "start",
      "fontWeight": "bold",
      "subtitleFont": "Inter",
      "subtitleFontSize": 12,
      "subtitleColor": "#64748b"
    }
  }
}
