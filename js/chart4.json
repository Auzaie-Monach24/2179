{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Compact normalised stacked bar of grouped Type by State.",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/housing_state_type_tenure_compact_2025.csv"
  },
  "transform": [
    {
      "filter": {
        "field": "State",
        "oneOf": [
          "Johor",
          "Selangor",
          "Perak",
          "Penang",
          "Negeri Sembilan",
          "Kuala Lumpur",
          "Melaka",
          "Kedah"
        ]
      }
    }
  ],
  "mark": {
    "type": "bar"
  },
  "encoding": {
    "x": {
      "field": "State",
      "type": "nominal",
      "title": null,
      "sort": [
        "Johor",
        "Selangor",
        "Perak",
        "Penang",
        "Negeri Sembilan",
        "Kuala Lumpur",
        "Melaka",
        "Kedah"
      ],
      "axis": {
        "labelAngle": -20
      }
    },
    "y": {
      "aggregate": "sum",
      "field": "Transactions",
      "type": "quantitative",
      "stack": "normalize",
      "title": "Share of Transactions",
      "axis": {
        "format": "%"
      }
    },
    "color": {
      "field": "Type",
      "type": "nominal",
      "title": "Grouped Type",
      "scale": {
        "domain": [
          "Terrace-based homes",
          "High-rise homes",
          "Semi-D / Cluster homes",
          "Bungalow-based homes",
          "Town House",
          "Other property types"
        ],
        "range": [
          "#2563eb",
          "#f59e0b",
          "#10b981",
          "#ef4444",
          "#8b5cf6",
          "#94a3b8"
        ]
      }
    },
    "tooltip": [
      {
        "field": "State"
      },
      {
        "field": "Type",
        "title": "Grouped Type"
      },
      {
        "aggregate": "sum",
        "field": "Transactions",
        "type": "quantitative",
        "format": ",.0f"
      },
      {
        "aggregate": "mean",
        "field": "Median_Price",
        "type": "quantitative",
        "format": ",.0f"
      }
    ]
  },
  "title": {
    "text": "What housing types shape each active state?",
    "subtitle": "Grouped property types reduce legend clutter while preserving the State, Type and Transactions story"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#e7ecf2"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom"
    },
    "title": {
      "font": "Inter",
      "fontSize": 16,
      "anchor": "start",
      "fontWeight": "bold",
      "subtitleFont": "Inter",
      "subtitleFontSize": 12,
      "subtitleColor": "#64748b"
    }
  }
}
