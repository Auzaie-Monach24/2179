{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Aligned state profile comparing Transactions and Median_Price without radial angle/radius judgments.",
  "data": {
    "url": "data/state_summary_2025.csv"
  },
  "hconcat": [
    {
      "width": 460,
      "height": 315,
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {
            "field": "Transactions",
            "order": "descending"
          },
          "title": null
        },
        "x": {
          "field": "Transactions",
          "type": "quantitative",
          "title": "Transactions"
        },
        "color": {
          "value": "#2563eb"
        },
        "tooltip": [
          {
            "field": "State"
          },
          {
            "field": "Transactions",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "Median_Price",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "u_rate",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "width": 300,
      "height": 315,
      "mark": {
        "type": "circle",
        "size": 105,
        "opacity": 0.9
      },
      "encoding": {
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {
            "field": "Transactions",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labels": false,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "Median_Price",
          "type": "quantitative",
          "title": "Median Property Price (RM)",
          "axis": {
            "format": "~s"
          }
        },
        "color": {
          "field": "u_rate",
          "type": "quantitative",
          "title": "Unemployment Rate (%)",
          "scale": {
            "scheme": "reds"
          }
        },
        "tooltip": [
          {
            "field": "State"
          },
          {
            "field": "Median_Price",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "Transactions",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "u_rate",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "independent",
      "color": "independent"
    }
  },
  "title": {
    "text": "Which states are active, expensive, or both?",
    "subtitle": "Aligned bars and dots replace the radial chart, using common sight lines for clearer comparison"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#e7ecf2"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom"
    },
    "title": {
      "font": "Inter",
      "fontSize": 16,
      "anchor": "start",
      "fontWeight": "bold",
      "subtitleFont": "Inter",
      "subtitleFontSize": 12,
      "subtitleColor": "#64748b"
    }
  }
}
