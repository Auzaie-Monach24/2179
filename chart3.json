{
  "description": "Ordered state transactions bar chart.",
  "width": "container",
  "height": 360,
  "data": {
    "url": "state_summary_2025.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4
  },
  "encoding": {
    "y": {
      "field": "State",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "Transactions",
      "type": "quantitative",
      "title": "Transactions",
      "axis": {
        "format": ",.0f"
      }
    },
    "color": {
      "field": "Median_PSF",
      "type": "quantitative",
      "title": "Median_PSF (RM)",
      "scale": {
        "scheme": "tealblues"
      }
    },
    "tooltip": [
      {
        "field": "State"
      },
      {
        "field": "Transactions",
        "type": "quantitative",
        "format": ",.0f"
      },
      {
        "field": "Median_Price",
        "type": "quantitative",
        "format": ",.0f"
      },
      {
        "field": "Median_PSF",
        "type": "quantitative",
        "format": ",.0f"
      }
    ]
  },
  "title": {
    "text": "Which states recorded the most housing transactions?",
    "subtitle": "Length encodes transaction volume; colour adds price-per-square-foot context"
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Open Sans",
      "titleFont": "Open Sans",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#e7ecf2"
    },
    "legend": {
      "labelFont": "Open Sans",
      "titleFont": "Open Sans",
      "orient": "bottom"
    },
    "title": {
      "font": "Open Sans",
      "fontSize": 16,
      "anchor": "start",
      "fontWeight": "bold",
      "subtitleFont": "Open Sans",
      "subtitleFontSize": 12,
      "subtitleColor": "#64748b"
    }
  }
}